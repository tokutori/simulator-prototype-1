{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tokutori:birdman:model-contract:0.11.0",
  "title": "Birdman flight dynamics prototype model contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "mass_properties",
    "reference_geometry",
    "aerodynamics",
    "actuators",
    "sensors",
    "environment",
    "initial_state",
    "reference_controller"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "0.11.0" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "provenance", "validation_status", "valid_for", "sources", "assumptions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "validation_status": { "type": "string", "minLength": 1 },
        "valid_for": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "url", "applies_to", "authority"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1, "pattern": "^https://" },
              "applies_to": { "type": "string", "minLength": 1 },
              "authority": { "type": "string", "minLength": 1 }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mass_properties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mass_kg", "inertia_body_kg_m2"],
      "properties": {
        "mass_kg": { "type": "number", "exclusiveMinimum": 0 },
        "inertia_body_kg_m2": {
          "type": "object",
          "description": "Symmetric tensor [[ixx,0,ixz],[0,iyy,0],[ixz,0,izz]]. ixz is the literal matrix element.",
          "additionalProperties": false,
          "required": ["ixx", "iyy", "izz", "ixz"],
          "properties": {
            "ixx": { "type": "number", "exclusiveMinimum": 0 },
            "iyy": { "type": "number", "exclusiveMinimum": 0 },
            "izz": { "type": "number", "exclusiveMinimum": 0 },
            "ixz": { "type": "number" }
          }
        }
      }
    },
    "reference_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area_m2", "span_m", "chord_m", "moment_reference"],
      "properties": {
        "area_m2": { "type": "number", "exclusiveMinimum": 0 },
        "span_m": { "type": "number", "exclusiveMinimum": 0 },
        "chord_m": { "type": "number", "exclusiveMinimum": 0 },
        "moment_reference": { "type": "string", "minLength": 1 }
      }
    },
    "aerodynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["force_coefficient_basis", "out_of_range_policy", "longitudinal_table", "derivatives_per_rad", "ground_effect"],
      "properties": {
        "force_coefficient_basis": { "enum": ["wind-axes", "stability-lift-drag-body-side"] },
        "out_of_range_policy": {
          "enum": ["terminate", "clamp-and-flag"],
          "description": "Host behavior after alpha leaves the supplied table. The core always holds the nearest endpoint so loads remain finite."
        },
        "longitudinal_table": {
          "type": "array",
          "description": "Strictly increasing alpha_deg; core clamps rather than extrapolates outside the table.",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alpha_deg", "cl", "cd", "cm"],
            "properties": {
              "alpha_deg": { "type": "number" },
              "cl": { "type": "number" },
              "cd": { "type": "number", "minimum": 0 },
              "cm": { "type": "number" }
            }
          }
        },
        "derivatives_per_rad": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cl_elevator", "cm_elevator", "cm_pitch_rate",
            "cy_beta", "cy_roll_rate", "cy_yaw_rate", "cy_rudder",
            "c_roll_beta", "c_roll_roll_rate", "c_roll_yaw_rate", "c_roll_rudder",
            "cn_beta", "cn_roll_rate", "cn_yaw_rate", "cn_rudder"
          ],
          "properties": {
            "cl_elevator": { "type": "number" },
            "cm_elevator": { "type": "number" },
            "cm_pitch_rate": { "type": "number" },
            "cy_beta": { "type": "number" },
            "cy_roll_rate": { "type": "number" },
            "cy_yaw_rate": { "type": "number" },
            "cy_rudder": { "type": "number" },
            "c_roll_beta": { "type": "number" },
            "c_roll_roll_rate": { "type": "number" },
            "c_roll_yaw_rate": { "type": "number" },
            "c_roll_rudder": { "type": "number" },
            "cn_beta": { "type": "number" },
            "cn_roll_rate": { "type": "number" },
            "cn_yaw_rate": { "type": "number" },
            "cn_rudder": { "type": "number" }
          }
        },
        "ground_effect": {
          "type": "object",
          "description": "Optional induced-drag-only correlation. Free-air CD tables remain the authoritative base.",
          "additionalProperties": false,
          "required": ["enabled", "wing_height_offset_m", "induced_drag_factor", "minimum_induced_drag_ratio", "correlation_gain", "height_exponent"],
          "properties": {
            "enabled": { "type": "boolean" },
            "wing_height_offset_m": { "type": "number" },
            "induced_drag_factor": { "type": "number", "minimum": 0 },
            "minimum_induced_drag_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "correlation_gain": { "type": "number", "exclusiveMinimum": 0 },
            "height_exponent": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "actuators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elevator", "rudder"],
      "properties": {
        "elevator": { "$ref": "#/$defs/actuator" },
        "rudder": { "$ref": "#/$defs/actuator" }
      }
    },
    "sensors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imu", "air_data", "alpha_sample_rate_hz", "alpha_bias_deg", "alpha_resolution_deg"],
      "properties": {
        "imu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sample_rate_hz", "gyro_bias_deg_s", "gyro_resolution_deg_s", "euler_resolution_deg", "acceleration_resolution_mps2"],
          "properties": {
            "sample_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
            "gyro_bias_deg_s": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "number" }
            },
            "gyro_resolution_deg_s": { "type": "number", "exclusiveMinimum": 0 },
            "euler_resolution_deg": { "type": "number", "exclusiveMinimum": 0 },
            "acceleration_resolution_mps2": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "air_data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["differential_pressure_sample_rate_hz", "static_pressure_sample_rate_hz", "differential_pressure_range_pa", "differential_pressure_resolution_pa", "differential_pressure_bias_pa", "differential_pressure_time_constant_s", "pitot_coefficient", "static_pressure_resolution_pa", "static_pressure_bias_pa"],
          "properties": {
            "differential_pressure_sample_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
            "static_pressure_sample_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
            "differential_pressure_range_pa": { "type": "number", "exclusiveMinimum": 0 },
            "differential_pressure_resolution_pa": { "type": "number", "exclusiveMinimum": 0 },
            "differential_pressure_bias_pa": { "type": "number" },
            "differential_pressure_time_constant_s": { "type": "number", "exclusiveMinimum": 0 },
            "pitot_coefficient": { "type": "number", "exclusiveMinimum": 0 },
            "static_pressure_resolution_pa": { "type": "number", "exclusiveMinimum": 0 },
            "static_pressure_bias_pa": { "type": "number" }
          }
        },
        "alpha_sample_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "alpha_bias_deg": { "type": "number" },
        "alpha_resolution_deg": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["density_kg_m3", "gravity_mps2", "wind_ned_mps", "one_minus_cosine_gust"],
      "properties": {
        "density_kg_m3": { "type": "number", "minimum": 0 },
        "gravity_mps2": { "type": "number", "minimum": 0 },
        "wind_ned_mps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "one_minus_cosine_gust": {
          "type": "object",
          "description": "A deterministic full one-minus-cosine pulse evaluated along the NED north coordinate.",
          "additionalProperties": false,
          "required": ["enabled", "start_north_m", "length_m", "peak_wind_ned_mps"],
          "properties": {
            "enabled": { "type": "boolean" },
            "start_north_m": { "type": "number" },
            "length_m": { "type": "number", "exclusiveMinimum": 0 },
            "peak_wind_ned_mps": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "number" }
            }
          }
        }
      }
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["altitude_m", "velocity", "roll_deg", "pitch_deg", "heading_deg"],
      "properties": {
        "altitude_m": { "type": "number", "minimum": 0 },
        "velocity": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["frame", "speed_mps", "flight_path_deg", "track_deg"],
              "properties": {
                "frame": { "const": "ground-relative" },
                "speed_mps": { "type": "number", "minimum": 0 },
                "flight_path_deg": { "type": "number", "minimum": -90, "maximum": 90 },
                "track_deg": { "type": "number" }
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["frame", "airspeed_mps", "alpha_deg"],
              "properties": {
                "frame": { "const": "air-relative" },
                "airspeed_mps": { "type": "number", "minimum": 0 },
                "alpha_deg": { "type": "number" }
              }
            }
          ]
        },
        "roll_deg": { "type": "number" },
        "pitch_deg": { "type": "number" },
        "heading_deg": { "type": "number" }
      }
    },
    "reference_controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pull_out_start_airspeed_mps", "pull_out_full_airspeed_mps", "launch_target_alpha_deg", "launch_elevator_feedforward_deg", "failsafe_elevator_deg", "launch_alpha_gain", "glide_target_flight_path_deg", "flight_path_gain", "flight_path_lookahead_s", "degraded_flight_path_lookahead_s", "degraded_pull_out_start_altitude_loss_m", "degraded_pull_out_full_altitude_loss_m", "climb_limit_flight_path_deg", "climb_suppression_gain", "ground_climb_limit_mps", "ground_climb_suppression_gain_rad_per_mps", "vertical_speed_filter_time_constant_s", "alpha_limit_deg", "alpha_limit_gain", "launch_pitch_rate_gain_s", "glide_pitch_rate_gain_s", "glide_damping_enable_flight_path_deg", "glide_damping_transition_time_s", "automatic_elevator_limit_deg", "automatic_elevator_rate_limit_deg_s", "automatic_elevator_filter_time_constant_s"],
      "properties": {
        "pull_out_start_airspeed_mps": { "type": "number", "exclusiveMinimum": 0 },
        "pull_out_full_airspeed_mps": { "type": "number", "exclusiveMinimum": 0 },
        "launch_target_alpha_deg": { "type": "number" },
        "launch_elevator_feedforward_deg": { "type": "number" },
        "failsafe_elevator_deg": { "type": "number" },
        "launch_alpha_gain": { "type": "number", "minimum": 0 },
        "glide_target_flight_path_deg": { "type": "number", "maximum": 0 },
        "flight_path_gain": { "type": "number", "minimum": 0 },
        "flight_path_lookahead_s": { "type": "number", "minimum": 0 },
        "degraded_flight_path_lookahead_s": { "type": "number", "minimum": 0 },
        "degraded_pull_out_start_altitude_loss_m": { "type": "number", "minimum": 0 },
        "degraded_pull_out_full_altitude_loss_m": { "type": "number", "exclusiveMinimum": 0 },
        "climb_limit_flight_path_deg": { "type": "number", "maximum": 0 },
        "climb_suppression_gain": { "type": "number", "minimum": 0 },
        "ground_climb_limit_mps": { "type": "number", "maximum": 0 },
        "ground_climb_suppression_gain_rad_per_mps": { "type": "number", "minimum": 0 },
        "vertical_speed_filter_time_constant_s": { "type": "number", "exclusiveMinimum": 0 },
        "alpha_limit_deg": { "type": "number" },
        "alpha_limit_gain": { "type": "number", "minimum": 0 },
        "launch_pitch_rate_gain_s": { "type": "number", "minimum": 0 },
        "glide_pitch_rate_gain_s": { "type": "number", "minimum": 0 },
        "glide_damping_enable_flight_path_deg": { "type": "number", "maximum": 0 },
        "glide_damping_transition_time_s": { "type": "number", "exclusiveMinimum": 0 },
        "automatic_elevator_limit_deg": { "type": "number", "exclusiveMinimum": 0 },
        "automatic_elevator_rate_limit_deg_s": { "type": "number", "exclusiveMinimum": 0 },
        "automatic_elevator_filter_time_constant_s": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "$defs": {
    "actuator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_abs_deg", "max_rate_deg_s", "time_constant_s", "deadband_deg", "command_resolution_deg"],
      "properties": {
        "max_abs_deg": { "type": "number", "exclusiveMinimum": 0 },
        "max_rate_deg_s": { "type": "number", "exclusiveMinimum": 0 },
        "time_constant_s": { "type": "number", "exclusiveMinimum": 0 },
        "deadband_deg": { "type": "number", "minimum": 0 },
        "command_resolution_deg": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
